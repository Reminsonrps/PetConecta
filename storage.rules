rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pets/{fileName} {
      allow read: if true;
      // Imagens passam pela moderação no backend antes de serem gravadas.
      allow create, update: if false;
      allow delete: if request.auth != null
        && resource.metadata.uploadedBy == request.auth.token.email;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
